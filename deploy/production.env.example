APP_NAME=ColisFirst
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Set the exact HTTPS URL assigned by the hosting provider.
APP_URL=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Single instance: mount a persistent volume at /var/www/html/storage.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PRIVATE_DOCUMENT_DISK=local

# Only use * behind the provider's reverse proxy (no direct public container access).
TRUSTED_PROXIES=*
MARKETPLACE_DEMO=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ColisFirst

# Keep disabled until a TEST key and the hosted webhook signing secret are supplied.
STRIPE_ENABLED=false
STRIPE_LIVE=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

LEGAL_OPERATOR=
LEGAL_STATUS=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_DIRECTOR=
LEGAL_VAT=
LEGAL_HOST=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
LEGAL_MEDIATOR=
