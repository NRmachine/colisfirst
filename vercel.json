{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "public/build/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/css/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/js/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/images/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/favicon.*",
      "use": "@vercel/static"
    },
    {
      "src": "public/apple-touch-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "public/robots.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(build|css|js|images)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(favicon\\.(?:ico|svg)|apple-touch-icon\\.png|robots\\.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_LOCALE": "fr",
    "APP_FALLBACK_LOCALE": "fr",
    "APP_CONFIG_CACHE": "/tmp/colisfirst-config.php",
    "APP_EVENTS_CACHE": "/tmp/colisfirst-events.php",
    "APP_PACKAGES_CACHE": "/tmp/colisfirst-packages.php",
    "APP_ROUTES_CACHE": "/tmp/colisfirst-routes.php",
    "APP_SERVICES_CACHE": "/tmp/colisfirst-services.php",
    "VIEW_COMPILED_PATH": "/tmp/colisfirst-views",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database",
    "SESSION_SECURE_COOKIE": "true",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "sync",
    "MARKETPLACE_DEMO": "false",
    "STRIPE_ENABLED": "false",
    "STRIPE_LIVE": "false"
  }
}
